# Copy this file to .env and fill in your values
# Get a free Groq API key at: https://console.groq.com/keys

GROQ_API_KEY=gsk_REPLACE_WITH_YOUR_KEY

# Telegram bot token — get one by messaging @BotFather on Telegram
TELEGRAM_BOT_TOKEN=REPLACE_WITH_YOUR_TELEGRAM_BOT_TOKEN

# Base URL of the running FastAPI server (default shown)
FLOWGUARD_API_URL=http://localhost:8000

# ── Production (webhook mode) ──────────────────────────────────────────
# Set both to switch the Telegram bot from local polling to a webhook
# registered on this same FastAPI process. Leave unset for local dev
# (python -m flowguard.telegram_bot runs polling instead).

# Public HTTPS URL of the deployed service (e.g. https://your-app.up.railway.app)
FLOWGUARD_PUBLIC_URL=

# Random string Telegram must echo back on each webhook call, to verify
# requests actually came from Telegram. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
TELEGRAM_WEBHOOK_SECRET=

# Path to the SQLite file. On Railway, point this at your mounted volume
# (e.g. /data/flowguard.db) so the DB survives redeploys.
FLOWGUARD_DB_PATH=
